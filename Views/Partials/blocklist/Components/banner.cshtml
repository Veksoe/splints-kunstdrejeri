@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<
Umbraco.Cms.Core.Models.Blocks.BlockListItem < Banner >>
@using Umbraco.Cms.Web.Common.PublishedModels;

@{
    Banner content = Model.Content;
    var media = content.BackgroundMedia;
}

<div class="relative px-4 py-16 lg:py-32 primaryBgColor overflow-hidden">

    @if(media != null)
    {
        var mediaType = media.ContentType.Alias;

        if(mediaType == "Image")
        {
            <img src="@media.GetCropUrl()"
                 alt=""
                 class="absolute inset-0 w-full h-full object-cover opacity-50 pointer-events-none z-0" />
        } else if(mediaType == "umbracoMediaVideo")
        {
            <video autoplay muted loop playsinline
                   class="absolute inset-0 w-full h-full object-cover opacity-50 pointer-events-none z-0">
                <source src="@media.Url()" type="video/mp4" />
            </video>
        }
    }

    <div class="relative mx-auto max-w-[1280px] z-10 text-center">
        <h2 class="detailFont text-5xl lg:text-7xl onPrimaryColor font-bold">
            @content.Heading
        </h2>

        <h3 class="text-lg lg:text-2xl mb-4 onPrimaryColor">
            @content.Subheading
        </h3>

        @if(content.Button?.Url != null)
        {
            <a href="@content.Button.Url" class="btn">
                @content.Button.Name
            </a>
        }
    </div>
</div>
