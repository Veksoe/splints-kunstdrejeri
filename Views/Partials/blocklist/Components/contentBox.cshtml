@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem<ContentBox>>
@using Umbraco.Cms.Web.Common.PublishedModels;
@{
    ContentBox content = Model.Content;
    var icon = content.Icon;

}
<div class="p-6 shadow accentBgColor text-center onAccentColor">
    @if(icon != null)
    {
        <div class="w-16 h-16 lg:w-24 lg:h-24 mx-auto mb-4">
            <img src="@icon.GetCropUrl()" alt="" class="w-full h-full object-contain!" />
        </div>
    }

    <h3 class="text-xl mb-2">@content.Heading</h3>

    @if(!string.IsNullOrWhiteSpace(content.Body))
    {
        <p class="mb-4">@content.Body</p>
    }

    @if(content.Button != null && content.Button.Url != null)
    {
        <a href="@content.Button.Url" class="btn min-w-fit!">
            @content.Button.Name
        </a>
    }
</div>