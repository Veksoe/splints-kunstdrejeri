@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem<ImageCarousel>>
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Web.Common.PublishedModels;
@{
    ImageCarousel content = Model.Content;
    var settings = Model.Settings;
    var images = content.Images;
}

@if(images != null && images.Any())
{
<h2 class="text-2xl text-center mb-2">@content.Heading</h2>
    <swiper-container loop="true"
                      navigation="true"
                      pagination="true"
                      pagination-clickable="true"
                      space-between="0"
                      effect="coverflow"
                      centered-slides="true"
                      slides-per-view="auto"
                      coverflow-effect-rotate="40"
                      coverflow-effect-stretch="0"
                      coverflow-effect-depth="100"
                      coverflow-effect-modifier="1"
                      coverflow-effect-slide-shadows="true"
                      class="w-full h-[480px] lg:h-[600px]">
        @foreach(var img in images)
        {
            <swiper-slide class="rounded-xl w-[70vw] h-[450px] overflow-hidden relative lg:w-[70%] lg:h-[570px] ">
                <img src="@img.GetCropUrl()"
                     alt="@img.Name"
                     class="w-full h-full object-cover" />
            </swiper-slide>
        }
    </swiper-container>
    @if(content.Button != null && !string.IsNullOrEmpty(content.Button.Url))
    {
       
            <a href="@content.Button.Url"
               class="btn mt-0!">
                @content.Button.Name
            </a>
    }

}